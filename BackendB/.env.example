# ==============================================================================
# InterviewIQ - Backend B Configuration
# ==============================================================================

# Google Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AQ.Ab8RN6JpTEJajVoLA894eV1lKtsCO7jgmyVtarpq2RLwpnMcQQ
# Model Selection: pin a specific model from Google AI Studio (e.g., gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.4
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3

# Interview Budgeting Defaults
AVERAGE_QUESTION_MINUTES=3
DEFAULT_INTERVIEW_MINUTES=30

# Strategy: 'single_call' (1 call for entire plan) or 'per_competency'
GENERATION_STRATEGY=single_call
MAX_CONCURRENT_LLM_CALLS=1

# In-Memory / File Cache TTL in seconds
CACHE_TTL_SECONDS=3600
